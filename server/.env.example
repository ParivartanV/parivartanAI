# Server Configuration
PORT=4000
NODE_ENV=development

# Database: SQLite for local desktop ("file:./dev.db"), PostgreSQL for production ("postgresql://user:password@localhost:5432/parivartan?schema=public")
DATABASE_URL="file:./dev.db"

# Security & JWT
JWT_SECRET="replace-with-a-random-64-char-string-in-production"
ENCRYPTION_KEY="replace-with-a-random-32-byte-hex-string-for-aes-256"

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
