# Server & App Config
PORT=8000
ENVIRONMENT=development

# PostgreSQL Connection URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://admin:your_secret_password@localhost:5432/parivartan_db

# Security & JWT Tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_signing_key_replace_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# AES-256 Symmetric Encryption Key for sensitive client credentials & AI keys
# Must be exactly a 32-byte hex string (64 characters) or Fernet key
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth Client ID (Get from Google Cloud Console > APIs & Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
