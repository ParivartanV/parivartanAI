{
  "manifest_version": 3,
  "name": "Parivartan Snippet - Text Expander & Quick Replies",
  "short_name": "Parivartan",
  "version": "1.0.0",
  "description": "Speed up customer support tickets, emails, and repetitive typing with dynamic shortcuts and templates.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Parivartan Snippet"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "parivartan-snippet@psychz.net",
      "strict_min_version": "109.0"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/default_snippets.js",
        "shared/template_engine.js",
        "shared/ai_service.js",
        "shared/speech_service.js",
        "content_script.js"
      ],
      "css": [
        "content_style.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "cookies",
    "tabs",
    "declarativeNetRequest",
    "identity"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_unframe",
        "enabled": true,
        "path": "rules/declarative_rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*.chatgpt.com/*",
    "*://*.openai.com/*",
    "*://*.claude.ai/*",
    "*://*.gemini.google.com/*",
    "*://*.google.com/*"
  ],
  "commands": {
    "open-palette": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Open Parivartan Snippet Quick Palette"
    }
  }
}
